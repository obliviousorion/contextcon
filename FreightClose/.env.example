# mock uses local fixtures only. live uses OpenAI and ECB reference FX.
FREIGHT_MODE=mock
OPENAI_API_KEY=
# Live intake uses the fixed gpt-4o-mini model for a bounded call budget.
# Optional: live or mock FX on its own. FREIGHT_FX=live with FREIGHT_MODE=mock uses the
# real ECB rate and the fixture invoice reader, so no OpenAI key is needed.
# FREIGHT_FX=live
# Optional path; defaults to separate local files per mode.
# FREIGHT_DB=freight-demo.sqlite3
